# Visual Library ayarlari. Bu dosyayi .env olarak kopyalayin (Kur.bat bunu kendisi yapar).
# Degisiklikten sonra Baslat.bat'i yeniden baslatin.

# Dinlenecek port
PORT=4099

# Domain geldiginde (ornek: http://galeri.sirket.local). Bos olabilir.
PUBLIC_URL=

# GitHub'dan otomatik guncelleme sikligi (dakika). 0 = otomatik kapali.
# Elle guncelleme icin Guncelle.bat calistirilir.
UPDATE_MINUTES=30
REPO=FikretGezer/visual-library
BRANCH=main

# ---- Giris (zorunlu) ----
# Oturum cerezlerini imzalayan gizli anahtar. En az 16 rastgele karakter; DEGISTIR olamaz.
SESSION_SECRET=DEGISTIR
# Kullanici tablosunun bulundugu veritabani (AiMonitoring'deki DATABASE_URL ile ayni bicim).
# Ornek: sqlserver://SUNUCU:1433;database=RPA_DB;user=KULLANICI;password=PAROLA;encrypt=true;trustServerCertificate=true
DATABASE_URL=
# Tablo bosken ilk yonetici(ler): virgulle ayrilmis e-postalar.
ADMIN_EMAILS=
# TmdAuth (AD dogrulama): degerleri AiMonitoring'deki infra\.env dosyasindan kopyalayin.
TMDAUTH_ENABLED=true
TMDAUTH_API_DOMAIN=
TMDAUTH_API_KEY=
TMDAUTH_API_PASS=
# email: AD'ye tam e-posta gider; localpart: @ oncesi gider
TMDAUTH_USER_MODE=email
TMDAUTH_INSECURE_SSL=false
TMDAUTH_TIMEOUT_MS=10000

# Yerel (AD disi) acil durum yoneticisi: AD ya da veritabani kapaliyken de giris yapabilir.
# Ikisi birlikte doldurulur; parola en az 12 karakter. Bos birakirsaniz kapali.
# Bu hesap tabloda gorunmez; yonetim sayfasini kullanabilir. Parolayi baskasiyla paylasmayin.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
